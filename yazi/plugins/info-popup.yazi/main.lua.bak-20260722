local M = {}

local hovered_info = ya.sync(function()
	local hovered = cx.active.current.hovered
	if not hovered then
		return nil
	end

	return {
		name = hovered.name,
		path = tostring(hovered.url),
		is_dir = hovered.cha.is_dir,
		size = hovered:size(),
	}
end)

-- Helper to format raw bytes into human-readable sizes
local function format_size(bytes)
	if not bytes then
		return "Unknown"
	end
	local units = { "B", "KB", "MB", "GB", "TB" }
	local i = 1
	while bytes >= 1024 and i < #units do
		bytes = bytes / 1024
		i = i + 1
	end
	return string.format("%.2f %s", bytes, units[i])
end

-- Helper to fetch image resolution via `identify` (ImageMagick)
local function get_image_resolution(path)
	local child, err = Command("identify"):args({ "-format", "%wx%h", path }):stdout(Command.PIPED):spawn()

	if not child then
		return nil
	end
	local output, _ = child:wait_with_output()
	if output and output.status.success then
		return output.stdout:gsub("%s+", "") -- strip whitespace/newlines
	end
	return nil
end

-- Helper to fetch PDF page count via `pdfinfo` or `qpdf`
local function get_pdf_pages(path)
	-- Try pdfinfo (poppler)
	local child = Command("pdfinfo"):arg(path):stdout(Command.PIPED):spawn()
	if child then
		local output = child:wait_with_output()
		if output and output.status.success then
			local pages = output.stdout:match("Pages:%s+(%d+)")
			if pages then
				return pages
			end
		end
	end

	-- Fallback: try qpdf
	local qpdf_child = Command("qpdf"):args({ "--show-npages", path }):stdout(Command.PIPED):spawn()
	if qpdf_child then
		local output = qpdf_child:wait_with_output()
		if output and output.status.success then
			return output.stdout:gsub("%s+", "")
		end
	end

	return nil
end

function M:entry()
	local hovered = hovered_info()
	if not hovered then
		ya.notify({ title = "File Info", content = "No file selected", timeout = 3.0, level = "warn" })
		return
	end

	local name = hovered.name
	local path = hovered.path
	local size_str = format_size(hovered.size)
	local lines = {}

	table.insert(lines, "Name: " .. name)

	if hovered.is_dir then
		table.insert(lines, "Type: Directory")
		table.insert(lines, "Size: " .. size_str)
	else
		table.insert(lines, "Size: " .. size_str)

		-- Check MIME type / extension for images and PDFs
		local ext = name:match("%.([^%.]+)$")
		ext = ext and ext:lower() or ""

		if ext == "pdf" then
			local pages = get_pdf_pages(path)
			if pages then
				table.insert(lines, "Pages: " .. pages)
			end
		elseif ext:match("^(png|jpg|jpeg|webp|gif|bmp|tiff)$") then
			local res = get_image_resolution(path)
			if res then
				table.insert(lines, "Resolution: " .. res)
			end
		end
	end

	-- Show popup window notification in Yazi
	ya.notify({
		title = "File Information",
		content = table.concat(lines, "\n"),
		timeout = 5.0,
		level = "info",
	})
end

return M
